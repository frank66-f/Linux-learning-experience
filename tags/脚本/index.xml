#!/bin/bash if [ $# -ne 1 ]; then echo &amp;#34;用法: $0 n&amp;#34; exit 1 fi n=$1 sum=0 for ((i=1; i&amp;lt;=n; i++)); do sum=$((sum+i)) done echo &amp;#34;结果: $sum&amp;#34;</description></item></channel></rss>